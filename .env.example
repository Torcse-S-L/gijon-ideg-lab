# ──────────────────────────────────────────────────────────────────────────────
# Gijon IDEG Lab — Variables de entorno
# Copiar este fichero a .env y ajustar los valores antes de levantar el stack.
# NUNCA subir el fichero .env al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=GISDB
POSTGRES_USER=gisadmin
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_PORT=5432

# ─── GeoServer ───────────────────────────────────────────────────────────────
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=cambia_esta_password
GEOSERVER_PORT=8080
GEOSERVER_INITIAL_MEMORY=2G
GEOSERVER_MAX_MEMORY=4G

# ─── GeoNetwork ──────────────────────────────────────────────────────────────
GEONETWORK_PORT=8081

# ─── QGIS Server ─────────────────────────────────────────────────────────────
QGIS_SERVER_PORT=8082

# ─── MapStore (Visor IDEG) ───────────────────────────────────────────────────
MAPSTORE_PORT=80

# ─── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=cambia_esta_password
GRAFANA_PORT=3000

# ─── Prometheus ──────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090

# ─── Elasticsearch / Kibana ──────────────────────────────────────────────────
ELASTIC_PASSWORD=cambia_esta_password
ES_PORT=9200
KIBANA_PORT=5601
